<?xml version="1.0" encoding="utf-8"?>
<!--
  文件清单不写在这里，由 heat 从 dist/ 目录直接采集成 ComponentGroup "AppFiles"。
  ffmpeg 的那堆 DLL 会随版本改名（avcodec-63.dll 之类），手写清单必然过期。

  UpgradeCode 一旦发布就不能再改：它是「同一个产品」的身份，变了之后新版本
  装上去不会替换旧版本，而是两个并存。
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Interview Studio 面试录音"
           Language="2052"
           Codepage="936"
           Version="$(var.Version)"
           Manufacturer="Neomelt"
           UpgradeCode="7B5F0C2E-2C9E-4E7A-9E9B-4B1D2A6C3F84">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Languages="2052"
             SummaryCodepage="936"
             Description="双轨会议/面试录音" />

    <MajorUpgrade DowngradeErrorMessage="已经安装了更新版本的 Interview Studio。" />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="APPLICATIONFOLDER" Name="Interview Studio" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- 快捷方式组件必须有 KeyPath，而快捷方式目录里放不了文件，
         所以按惯例拿一个 HKCU 注册表值当 KeyPath。 -->
    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="9C1A4D77-5E3B-4A2F-8D61-0F7C9B2E5A13">
        <Shortcut Id="StartMenuLink"
                  Name="面试录音"
                  Description="双轨录音（你 + 对方）"
                  Target="[APPLICATIONFOLDER]interview-studio.exe"
                  WorkingDirectory="APPLICATIONFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\Neomelt\InterviewStudio"
                       Name="startmenu"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="1E6B3F94-8A72-4C5D-B0E3-7D2A9C41F658">
        <Shortcut Id="DesktopLink"
                  Name="面试录音"
                  Description="双轨录音（你 + 对方）"
                  Target="[APPLICATIONFOLDER]interview-studio.exe"
                  WorkingDirectory="APPLICATIONFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\Neomelt\InterviewStudio"
                       Name="desktop"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- 拆成三个 Feature，安装界面才能让用户单独勾掉快捷方式。
         ConfigurableDirectory 是「浏览…」按钮能改安装路径的前提。 -->
    <Feature Id="MainProgram"
             Title="主程序"
             Description="Interview Studio 与随包的 FFmpeg"
             Level="1"
             Absent="disallow"
             ConfigurableDirectory="APPLICATIONFOLDER">
      <ComponentGroupRef Id="AppFiles" />

      <Feature Id="StartMenuFeature"
               Title="开始菜单快捷方式"
               Description="在开始菜单里创建快捷方式"
               Level="1">
        <ComponentRef Id="StartMenuShortcut" />
      </Feature>

      <Feature Id="DesktopFeature"
               Title="桌面快捷方式"
               Description="在桌面上创建快捷方式"
               Level="1">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>

    <Icon Id="AppIcon.ico" SourceFile="packaging\icons\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Neomelt/interview-studio" />

    <!-- FeatureTree 而不是 Minimal：它的自定义页既能勾选功能（快捷方式），
         又带「浏览…」可以改安装位置。Minimal 两样都没有。 -->
    <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\windows\license.rtf" />
    <UIRef Id="WixUI_FeatureTree" />
  </Product>
</Wix>
